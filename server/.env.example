# Puerto del servidor
PORT=8787

# Clave API usada por las billeteras (header x-api-key).
# DEBE coincidir con cerebro_api_key configurada en la app.
CEREBRO_API_KEY=tu_clave_secreta_cambiar

# Contrasena del dashboard web admin (login).
ADMIN_PASSWORD=cambiar_esta_contrasena

# Token secreto para firmar sesiones del dashboard.
SESSION_SECRET=cambiar_este_secreto_largo
